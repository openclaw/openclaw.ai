---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { siSpotify, siYoutube } from 'simple-icons';
import Layout from '../../layouts/Layout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {
  formatEpisodeDate,
  getEpisodeSummary,
  podcastEpisodes,
  type PodcastEpisode,
} from '../../data/podcast';

export function getStaticPaths() {
  return podcastEpisodes.map((episode) => ({
    params: { episode: episode.slug },
    props: { episode },
  }));
}

const { episode } = Astro.props as { episode: PodcastEpisode };
const episodeIndex = podcastEpisodes.findIndex((item) => item.slug === episode.slug);
const newerEpisode = podcastEpisodes[episodeIndex - 1];
const olderEpisode = podcastEpisodes[episodeIndex + 1];
const canonicalUrl = `https://openclaw.ai/podcast/${episode.slug}`;
const shareImage = episode.shareImage ?? '/podcast/clawcast-share.png';
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: `The ClawCast - ${episode.title}`,
  url: canonicalUrl,
  datePublished: `${episode.airedAt}T12:00:00Z`,
  description: getEpisodeSummary(episode),
  image: `https://openclaw.ai${shareImage}`,
  partOfSeries: {
    '@type': 'PodcastSeries',
    name: 'The OpenClaw Podcast',
    url: 'https://openclaw.ai/podcast',
  },
  associatedMedia: {
    '@type': 'VideoObject',
    contentUrl: episode.youtubeUrl,
  },
};

function isUrl(value: string): boolean {
  return /^https?:\/\/\S+$/u.test(value);
}
---

<Layout
  title={`The ClawCast ${episode.title}`}
  description={getEpisodeSummary(episode)}
  canonicalUrl={canonicalUrl}
  ogImage={shareImage}
  ogImageWidth={1200}
  ogImageHeight={630}
  structuredData={structuredData}
>
  <main class="episode-page">
    <article>
      <a class="back-link" href="/podcast">
        <ArrowLeft size={16} aria-hidden="true" />
        All episodes
      </a>

      <header class="episode-hero">
        <div class="episode-intro">
          <p class="eyebrow">The ClawCast</p>
          <h1>{episode.title}</h1>
          <p class="episode-guests">{episode.guests}</p>
          <p class="episode-date">Aired {formatEpisodeDate(episode.airedAt)}</p>
          <div class="episode-actions" aria-label="Listen to this episode">
            <a href={episode.youtubeUrl} target="_blank" rel="noopener" class="episode-action episode-action--primary">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siYoutube.path} /></svg>
              Watch on YouTube
            </a>
            <a href={episode.spotifyUrl} target="_blank" rel="noopener" class="episode-action">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSpotify.path} /></svg>
              {episode.spotifyLabel}
            </a>
          </div>
        </div>

        <div class="episode-artwork-frame">
          <img
            src={shareImage}
            alt="The ClawCast with Hannes Rudolph"
            width="1200"
            height="630"
            class="episode-artwork"
            fetchpriority="high"
          />
        </div>
      </header>

      <section class="description" aria-label="Episode description">
        <div class="description-copy">
          {episode.description.split('\n\n').map((paragraph) => (
            <p>
              {paragraph.split(/(https?:\/\/\S+)/u).map((part) =>
                isUrl(part)
                  ? <a href={part} target="_blank" rel="noopener">{part}</a>
                  : part
              )}
            </p>
          ))}
        </div>
      </section>

      <nav class="episode-navigation" aria-label="Episode navigation">
        {newerEpisode ? (
          <a href={`/podcast/${newerEpisode.slug}`} class="episode-nav-link">
            <span>Newer episode</span>
            <strong>{newerEpisode.title}</strong>
          </a>
        ) : <span />}
        {olderEpisode ? (
          <a href={`/podcast/${olderEpisode.slug}`} class="episode-nav-link episode-nav-link--next">
            <span>Older episode</span>
            <strong>{olderEpisode.title} <ArrowRight size={16} aria-hidden="true" /></strong>
          </a>
        ) : <span />}
      </nav>
    </article>

    <SiteFooter current="podcast" credit="simple" />
  </main>
</Layout>

<style>
  .episode-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  article {
    width: min(100% - 64px, 960px);
    margin: 0 auto;
    padding-top: clamp(44px, 7vh, 76px);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--oc-text-secondary);
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .back-link:hover {
    color: var(--oc-accent-primary);
  }

  .back-link:focus-visible,
  .episode-action:focus-visible,
  .episode-nav-link:focus-visible {
    outline: 2px solid var(--oc-accent-primary);
    outline-offset: 3px;
  }

  .episode-hero {
    padding: clamp(42px, 6vw, 68px) 0 0;
  }

  .episode-intro {
    max-width: 760px;
  }

  .eyebrow {
    color: var(--oc-accent-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1,
  h2 {
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-weight: 600;
  }

  h1 {
    margin-top: 12px;
    font-size: clamp(3rem, 6vw, 4.8rem);
    line-height: 1;
  }

  .episode-guests {
    max-width: 580px;
    margin-top: 22px;
    color: var(--oc-text-primary);
    font-size: clamp(1.05rem, 2vw, 1.28rem);
    font-weight: 600;
  }

  .episode-date {
    margin-top: 9px;
    color: var(--oc-text-secondary);
  }

  .episode-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .episode-action {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    gap: 9px;
    padding: 10px 13px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 4px;
    color: var(--oc-text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .episode-action svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .episode-action--primary {
    border-color: var(--oc-accent-primary);
    background: var(--oc-accent-primary);
    color: var(--oc-bg-page);
  }

  .episode-action:hover {
    border-color: var(--oc-accent-primary);
    color: var(--oc-accent-primary);
  }

  .episode-action--primary:hover {
    background: transparent;
  }

  .episode-artwork-frame {
    width: min(100%, 860px);
    margin-top: clamp(40px, 6vw, 64px);
    padding: 7px;
    border: 1px solid var(--oc-border-subtle);
    background: var(--oc-surface-card-strong);
    box-shadow: 8px 8px 0 color-mix(in srgb, var(--oc-accent-primary) 38%, transparent);
  }

  .episode-artwork {
    display: block;
    width: 100%;
    height: auto;
  }

  .description {
    width: min(100%, 760px);
    padding: clamp(44px, 6vw, 64px) 0 clamp(52px, 7vw, 76px);
    border-bottom: 1px solid var(--oc-border-subtle);
  }

  .description-copy {
    max-width: 720px;
    color: var(--oc-text-secondary);
    font-size: 1.02rem;
    overflow-wrap: anywhere;
  }

  .description-copy p {
    white-space: pre-line;
  }

  .description-copy p + p {
    margin-top: 22px;
  }

  .description-copy a {
    color: var(--oc-text-primary);
    text-decoration-color: var(--oc-accent-primary);
    text-underline-offset: 3px;
  }

  .description-copy a:hover {
    color: var(--oc-accent-primary);
  }

  .episode-navigation {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    padding: 28px 0;
  }

  .episode-nav-link {
    display: grid;
    gap: 4px;
    color: var(--oc-text-primary);
    text-decoration: none;
  }

  .episode-nav-link span {
    color: var(--oc-text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .episode-nav-link strong {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--oc-font-display);
    font-size: 1.1rem;
  }

  .episode-nav-link--next {
    text-align: right;
    justify-items: end;
  }

  .episode-nav-link:hover strong {
    color: var(--oc-accent-primary);
  }

  @media (max-width: 720px) {
    article {
      width: min(100% - 40px, 1080px);
      padding-top: 46px;
    }

    .episode-hero {
      padding-top: 34px;
    }

    .description {
      padding: 38px 0 48px;
    }

    .episode-navigation {
      gap: 18px;
    }
  }
</style>
