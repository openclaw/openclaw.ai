---
import { Copy, Rss } from '@lucide/astro';
import { siApplepodcasts, siDiscord, siSpotify, siYoutube } from 'simple-icons';
import Layout from '../layouts/Layout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { formatEpisodeDate, formatPodcastPeople, getEpisodeSummary, podcastEpisodes } from '../data/podcast';

const spotifyUrl = 'https://open.spotify.com/show/033M5Wn9WAAdujY1qAcIYO';
const youtubeUrl = 'https://www.youtube.com/playlist?list=PLHl8GlRgxIlA';
const rssUrl = 'https://anchor.fm/s/114b28260/podcast/rss';
const discordUrl = 'https://discord.com/invite/clawd';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'OpenClaw Podcast',
  url: 'https://openclaw.ai/podcast',
  webFeed: rssUrl,
};
---

<Layout
  title="OpenClaw Podcast"
  description="The ClawCast is OpenClaw's official podcast, hosted by Hannes Rudolph. Listen on Spotify and YouTube, or subscribe with the RSS feed."
  canonicalUrl="https://openclaw.ai/podcast"
  ogImage="/podcast/clawcast-share.png"
  ogImageWidth={1200}
  ogImageHeight={630}
  structuredData={structuredData}
>
  <main class="podcast-page">
    <section class="podcast-hero" aria-labelledby="podcast-title">
      <div class="hero-content">
        <p class="eyebrow">The OpenClaw Podcast</p>
        <h1 id="podcast-title">The ClawCast</h1>
        <p class="intro">
          Hosted by Hannes Rudolph, The ClawCast features conversations with the people building, maintaining, and
          using OpenClaw.
        </p>
      </div>

      <div class="podcast-cover-frame">
        <img
          src="/podcast/clawcast-thumbnail.png"
          alt="The ClawCast with Hannes Rudolph"
          class="podcast-cover"
          width="1254"
          height="1254"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="listen-panel">
        <p class="listen-label">Listen and watch</p>
        <div class="platforms" aria-label="Podcast platforms">
          <a href={spotifyUrl} target="_blank" rel="noopener" class="platform-card">
            <span class="platform-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={siSpotify.path} /></svg>
            </span>
            <span class="platform-content">
              <span class="platform-name">Spotify</span>
              <span class="platform-action">Listen</span>
            </span>
          </a>

          <a href={youtubeUrl} target="_blank" rel="noopener" class="platform-card">
            <span class="platform-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={siYoutube.path} /></svg>
            </span>
            <span class="platform-content">
              <span class="platform-name">YouTube</span>
              <span class="platform-action">Watch</span>
            </span>
          </a>

          <div class="platform-card platform-card--coming-soon" aria-label="Apple Podcasts coming soon">
            <span class="platform-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={siApplepodcasts.path} /></svg>
            </span>
            <span class="platform-content">
              <span class="platform-name">Apple Podcasts</span>
              <span class="platform-action">Coming soon</span>
            </span>
          </div>
        </div>

        <div class="rss-utility" aria-label="RSS feed">
          <span class="rss-icon" aria-hidden="true"><Rss size={19} strokeWidth={1.8} /></span>
          <span class="rss-copy">
            <span class="rss-title">RSS feed</span>
            <span class="rss-description">Use it in any podcast app.</span>
          </span>
          <span class="rss-actions">
            <a href={rssUrl} target="_blank" rel="noopener" class="rss-open">Open</a>
            <button type="button" class="rss-button" data-copy-rss data-rss-url={rssUrl}>
              <Copy size={15} aria-hidden="true" />
              <span data-copy-rss-label>Copy</span>
            </button>
          </span>
        </div>
      </div>
    </section>

    <section class="episodes" aria-labelledby="episodes-title">
      <div class="episodes-heading">
        <p id="episodes-title" class="section-label">Episodes</p>
      </div>
      <ol class="episode-list">
        {podcastEpisodes.map((episode) => (
          <li class="episode-row">
            <div class="episode-row-meta">
              <span>Episode {episode.number}</span>
              <span>Aired {formatEpisodeDate(episode.airedAt)}</span>
            </div>
            <div class="episode-row-main">
              <h3><a href={`/podcast/${episode.slug}`}>{episode.title}</a></h3>
              <div class="episode-credits">
                <p><span>Hosts</span>{formatPodcastPeople(episode.hosts)}</p>
                {episode.guests.length > 0 && (
                  <p>
                    <span>{episode.guests.length === 1 ? 'Guest' : 'Guests'}</span>
                    {formatPodcastPeople(episode.guests)}
                  </p>
                )}
              </div>
              <p class="episode-summary">{getEpisodeSummary(episode)}</p>
            </div>
            <div class="episode-row-actions" aria-label={`Listen to ${episode.title}`}>
              <a href={episode.youtubeUrl} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siYoutube.path} /></svg>
                YouTube
              </a>
              <a href={episode.spotifyUrl} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSpotify.path} /></svg>
                {episode.spotifyLabel === 'Listen on Spotify' ? 'Spotify' : 'Spotify show'}
              </a>
              <a href={`/podcast/${episode.slug}`} class="episode-page-link">Episode page</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="live-recording" aria-labelledby="live-recording-title">
      <div>
        <p class="section-label">Live recording</p>
        <h2 id="live-recording-title">Join us every Wednesday at 11:30 AM PT.</h2>
      </div>
      <div class="live-details">
        <p>Join the OpenClaw Discord and select the active Stage when we are live to listen in.</p>
        <a href={discordUrl} target="_blank" rel="noopener" class="live-link">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siDiscord.path} /></svg>
          Join live on Discord
        </a>
      </div>
    </section>

    <section class="about-show" aria-labelledby="about-show-title">
      <div class="about-heading">
        <p class="section-label">Inside the show</p>
        <h2 id="about-show-title">Release deep-dives and the work of making agents useful every day.</h2>
      </div>
      <p class="about-copy">
        Hear from OpenClaw maintainers, contributors, and guests about what they are learning, what they are making,
        and what comes next for personal AI.
      </p>
    </section>

    <SiteFooter current="podcast" credit="simple" />
  </main>

  <script is:inline>
    const copyButton = document.querySelector('[data-copy-rss]');
    const copyLabel = document.querySelector('[data-copy-rss-label]');

    copyButton?.addEventListener('click', async () => {
      const url = copyButton.dataset.rssUrl;
      if (!url) return;

      try {
        await navigator.clipboard.writeText(url);
        copyLabel.textContent = 'Copied';
      } catch {
        window.prompt('Copy the RSS feed URL:', url);
      }

      window.setTimeout(() => {
        copyLabel.textContent = 'Copy RSS feed';
      }, 1800);
    });
  </script>
</Layout>

<style>
  .podcast-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .podcast-hero,
  .about-show,
  .live-recording,
  .episodes {
    width: min(100% - 64px, 1080px);
    margin-inline: auto;
  }

  .podcast-hero {
    display: grid;
    grid-template-areas:
      'content cover'
      'listen cover';
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: 34px 72px;
    align-items: start;
    padding: 76px 0 56px;
    border-bottom: 1px solid var(--oc-border-subtle);
  }

  .hero-content {
    grid-area: content;
    align-self: end;
    padding-top: 18px;
  }

  .eyebrow {
    margin-bottom: 14px;
    color: var(--oc-accent-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  h1 {
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-size: 4.75rem;
    font-weight: 600;
    line-height: 1;
  }

  .intro {
    max-width: 600px;
    margin-top: 18px;
    color: var(--oc-text-secondary);
    font-size: 1.12rem;
  }

  .podcast-cover-frame {
    grid-area: cover;
    width: min(100%, 340px);
    align-self: center;
    justify-self: end;
    padding: 6px;
    border: 1px solid var(--oc-border-subtle);
    background: var(--oc-surface-card-strong);
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--oc-accent-primary) 34%, transparent);
  }

  .podcast-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .about-show {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    gap: 42px;
    padding: clamp(42px, 7vw, 76px) 0;
    border-bottom: 1px solid var(--oc-border-subtle);
  }

  .section-label {
    color: var(--oc-accent-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .about-show h2 {
    max-width: 680px;
    margin-top: 14px;
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .about-copy {
    align-self: end;
    color: var(--oc-text-secondary);
    font-size: 1.02rem;
  }

  .episodes {
    padding: clamp(48px, 8vw, 88px) 0;
    border-bottom: 1px solid var(--oc-border-subtle);
  }

  .episodes-heading {
    margin-bottom: 18px;
  }

  .episode-list {
    border-top: 1px solid var(--oc-border-subtle);
    list-style: none;
  }

  .episode-row {
    display: grid;
    grid-template-columns: minmax(160px, 0.45fr) minmax(0, 1fr) minmax(148px, 0.32fr);
    gap: clamp(22px, 4vw, 54px);
    align-items: start;
    padding: 26px 0;
    border-bottom: 1px solid var(--oc-border-subtle);
  }

  .episode-row-meta {
    display: grid;
    gap: 6px;
    color: var(--oc-text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .episode-row-meta span:first-child {
    color: var(--oc-accent-primary);
  }

  .episode-row-main h3 {
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-size: clamp(1.38rem, 2.5vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .episode-row-main h3 a {
    color: inherit;
    text-decoration: none;
  }

  .episode-row-main h3 a:hover {
    color: var(--oc-accent-primary);
  }

  .episode-credits {
    display: grid;
    gap: 4px;
    margin-top: 8px;
  }

  .episode-credits p {
    display: grid;
    grid-template-columns: 50px minmax(0, 1fr);
    gap: 8px;
    color: var(--oc-text-primary);
    font-size: 0.94rem;
    font-weight: 600;
  }

  .episode-credits span {
    color: var(--oc-text-secondary);
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .episode-summary {
    margin-top: 12px;
    color: var(--oc-text-secondary);
  }

  .episode-row-actions {
    display: grid;
    justify-items: start;
    gap: 10px;
    padding-top: 2px;
  }

  .episode-row-actions a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--oc-text-secondary);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
  }

  .episode-row-actions svg {
    width: 16px;
    height: 16px;
    fill: currentColor;
  }

  .episode-row-actions a:hover {
    color: var(--oc-accent-primary);
  }

  .episode-row-actions a:focus-visible,
  .episode-row-main h3 a:focus-visible {
    outline: 2px solid var(--oc-accent-primary);
    outline-offset: 3px;
  }

  .episode-page-link {
    color: var(--oc-text-primary) !important;
  }

  .live-recording {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(260px, 0.8fr);
    gap: 42px;
    padding: clamp(42px, 7vw, 76px) 0;
    border-bottom: 1px solid var(--oc-border-subtle);
  }

  .live-recording h2 {
    max-width: 680px;
    margin-top: 14px;
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1.15;
  }

  .live-details {
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 20px;
    color: var(--oc-text-secondary);
    font-size: 1.02rem;
  }

  .live-link {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    padding: 9px 12px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 4px;
    color: var(--oc-text-primary);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .live-link svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  .live-link:hover {
    border-color: var(--oc-accent-primary);
    color: var(--oc-accent-primary);
  }

  .live-link:focus-visible {
    outline: 2px solid var(--oc-accent-primary);
    outline-offset: 2px;
  }

  .listen-panel {
    grid-area: listen;
  }

  .listen-label {
    margin-bottom: 10px;
    color: var(--oc-text-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .platform-card {
    display: grid;
    min-width: 0;
    min-height: 64px;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 4px;
    color: var(--oc-text-primary);
    text-decoration: none;
    transition: border-color 150ms ease, color 150ms ease;
  }

  .platform-card:hover {
    border-color: var(--oc-accent-primary);
  }

  .platform-card:focus-visible {
    outline: 2px solid var(--oc-accent-primary);
    outline-offset: 2px;
  }

  .platform-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    color: var(--oc-text-primary);
  }

  .platform-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .platform-content {
    display: grid;
    min-width: 0;
    gap: 1px;
  }

  .platform-name {
    overflow: hidden;
    font-size: 0.92rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .platform-action {
    color: var(--oc-text-secondary);
    font-size: 0.74rem;
  }

  .platform-card:hover .platform-action {
    color: var(--oc-accent-primary);
  }

  .platform-card--coming-soon {
    cursor: default;
    color: var(--oc-text-secondary);
  }

  .platform-card--coming-soon .platform-icon,
  .platform-card--coming-soon .platform-content {
    opacity: 0.7;
  }

  .rss-utility {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--oc-border-subtle);
  }

  .rss-icon {
    display: inline-flex;
    align-items: center;
    color: var(--oc-text-primary);
  }

  .rss-copy {
    display: grid;
    gap: 2px;
  }

  .rss-title {
    color: var(--oc-text-primary);
    font-weight: 600;
  }

  .rss-description {
    color: var(--oc-text-secondary);
    font-size: 0.8rem;
  }

  .rss-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .rss-open,
  .rss-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 32px;
    padding: 5px 8px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 4px;
    background: transparent;
    color: var(--oc-text-primary);
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    text-decoration: none;
  }

  .rss-button {
    cursor: pointer;
  }

  .rss-open:hover,
  .rss-button:hover {
    border-color: var(--oc-accent-primary);
    color: var(--oc-accent-primary);
  }

  .rss-open:focus-visible,
  .rss-button:focus-visible {
    outline: 2px solid var(--oc-accent-primary);
    outline-offset: 2px;
  }

  @media (max-width: 720px) {
    .podcast-hero,
    .about-show,
    .live-recording,
    .episodes {
      width: min(100% - 40px, 1080px);
    }

    .podcast-hero {
      grid-template-areas:
        'content'
        'cover'
        'listen';
      grid-template-columns: 1fr;
      gap: 28px;
      padding-top: 72px;
      padding-bottom: 44px;
    }

    .hero-content {
      padding-top: 0;
    }

    h1 {
      font-size: 3.25rem;
    }

    .podcast-cover-frame {
      width: min(100%, 320px);
      justify-self: start;
    }

    .about-show {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 42px 0;
    }

    .live-recording {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: 42px 0;
    }

    .episode-row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 24px 0;
    }

    .episode-row-meta {
      display: flex;
      flex-wrap: wrap;
      column-gap: 10px;
    }

    .episode-row-meta span + span::before {
      content: '·';
      margin-right: 10px;
      color: var(--oc-border-subtle);
    }

    .episode-row-actions {
      display: flex;
      flex-wrap: wrap;
      column-gap: 16px;
      row-gap: 10px;
    }

    .platforms {
      grid-template-columns: 1fr;
    }

    .platform-card {
      min-height: 58px;
      padding: 9px 11px;
    }

    .rss-utility {
      align-items: flex-start;
      flex-wrap: wrap;
    }

    .rss-actions {
      width: 100%;
      margin-left: 0;
    }
  }
</style>
