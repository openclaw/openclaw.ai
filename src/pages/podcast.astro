---
import { ArrowUpRight, Check, Rss } from '@lucide/astro';
import { siApplepodcasts, siDiscord, siSpotify, siYoutube } from 'simple-icons';
import Layout from '../layouts/Layout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteTopbar from '../components/SiteTopbar.astro';
import { formatEpisodeListDate, getEpisodeListingSummary, podcastEpisodes } from '../data/podcast';

const spotifyUrl = 'https://open.spotify.com/show/033M5Wn9WAAdujY1qAcIYO';
const youtubeUrl = 'https://www.youtube.com/playlist?list=PLHl8GlRgxIlA';
const rssUrl = 'https://anchor.fm/s/114b28260/podcast/rss';
const discordUrl = 'https://discord.com/invite/clawd';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'PodcastSeries',
  name: 'OpenClaw Podcast',
  url: 'https://openclaw.ai/podcast',
  webFeed: rssUrl,
};
---

<Layout
  title="OpenClaw Podcast"
  description="The ClawCast is OpenClaw's official video podcast, hosted by Hannes Rudolph. Find every episode on Spotify and YouTube, or subscribe with the RSS feed."
  canonicalUrl="https://openclaw.ai/podcast"
  ogImage="/podcast/clawcast-social-preview.png"
  ogImageWidth={1200}
  ogImageHeight={630}
  structuredData={structuredData}
>
  <SiteTopbar active="podcast" />

  <main class="podcast-page">
    <div class="rail">
    <section class="podcast-hero" aria-labelledby="podcast-title">
      <div class="hero-content">
        <p class="eyebrow">The OpenClaw Podcast</p>
        <h1 id="podcast-title">The ClawCast</h1>
        <p class="intro">
          Hosted by Hannes Rudolph, The ClawCast features conversations with the people building, maintaining, and
          using OpenClaw: release deep-dives, what maintainers and guests are learning, and what comes next for
          personal AI.
        </p>
        <a
          href={discordUrl}
          target="_blank"
          rel="noopener"
          class="live-recording-cta oc-action oc-action-secondary"
          aria-label="Join the live ClawCast recording on Discord, Wednesdays at 11:30 AM Pacific Time"
        >
          <span class="live-recording-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d={siDiscord.path} /></svg>
          </span>
          <span class="live-recording-copy">
            <span class="live-recording-label"><span class="live-recording-dot" aria-hidden="true"></span>Live recording</span>
            <strong>Join the ClawCast on Discord</strong>
            <span class="live-recording-time">Wednesdays at 11:30 AM PT</span>
          </span>
          <ArrowUpRight size={18} strokeWidth={1.8} aria-hidden="true" class="live-recording-arrow" />
        </a>
      </div>

      <div class="podcast-cover-frame">
        <img
          src="/podcast/clawcast-thumbnail.png"
          alt="The ClawCast with Hannes Rudolph"
          class="podcast-cover"
          width="1254"
          height="1254"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>

      <div class="platform-panel">
        <div class="platforms" role="group" aria-label="Podcast platforms">
          <a
            href={spotifyUrl}
            target="_blank"
            rel="noopener"
            class="platform-card"
            aria-label="Open The ClawCast on Spotify"
          >
            <span class="platform-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={siSpotify.path} /></svg>
            </span>
            <span class="platform-content">
              <span class="platform-name">Spotify</span>
            </span>
          </a>

          <a
            href={youtubeUrl}
            target="_blank"
            rel="noopener"
            class="platform-card"
            aria-label="Open The ClawCast on YouTube"
          >
            <span class="platform-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={siYoutube.path} /></svg>
            </span>
            <span class="platform-content">
              <span class="platform-name">YouTube</span>
            </span>
          </a>

          <div class="platform-card platform-card--coming-soon">
            <span class="platform-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d={siApplepodcasts.path} /></svg>
            </span>
            <span class="platform-content">
              <span class="platform-name">Apple Podcasts</span>
              <span class="platform-action">Coming soon</span>
            </span>
          </div>

          <button
            type="button"
            class="platform-card platform-card--rss"
            data-copy-rss
            data-rss-url={rssUrl}
            title="Copy RSS feed"
          >
            <Rss size={20} strokeWidth={1.8} aria-hidden="true" class="rss-icon" />
            <Check size={20} strokeWidth={2} aria-hidden="true" class="check-icon" />
            <span class="sr-only" data-copy-rss-label aria-live="polite">Copy RSS feed URL</span>
          </button>
        </div>
      </div>
    </section>

    <section class="episodes" aria-label="Episodes">
      <SectionHeader title="Episodes" />
      <ol class="episode-list">
        {podcastEpisodes.map((episode) => (
          <li class="episode-row">
            <div class="episode-row-meta">
              <span>EP. {String(episode.number).padStart(2, '0')}</span>
              <time datetime={episode.airedAt}>{formatEpisodeListDate(episode.airedAt)}</time>
            </div>

            <div class="episode-row-body">
              <div class="episode-row-header">
                <h3><a href={`/podcast/${episode.slug}`}>{episode.title}</a></h3>
                <div class="episode-row-actions" role="group" aria-label={`Platforms for ${episode.title}`}>
                  <a
                    href={episode.youtubeUrl}
                    target="_blank"
                    rel="noopener"
                    aria-label={`Open ${episode.title} on YouTube`}
                    title="YouTube"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siYoutube.path} /></svg>
                  </a>
                  <a
                    href={episode.spotifyUrl}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${episode.spotifyLabel}: ${episode.title}`}
                    title={episode.spotifyLabel === 'Open in Spotify' ? 'Spotify' : 'Spotify show'}
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSpotify.path} /></svg>
                  </a>
                </div>
              </div>
              <p class="episode-summary">{getEpisodeListingSummary(episode)}</p>
            </div>
          </li>
        ))}
      </ol>
    </section>
    </div>

    <SiteFooter current="podcast" credit="simple" />
  </main>

  <script is:inline>
    const copyButton = document.querySelector('[data-copy-rss]');
    const copyLabel = document.querySelector('[data-copy-rss-label]');

    copyButton?.addEventListener('click', async () => {
      const url = copyButton.dataset.rssUrl;
      if (!url) return;

      let copied = false;

      try {
        await navigator.clipboard.writeText(url);
        copied = true;
      } catch {
        const textarea = document.createElement('textarea');
        textarea.value = url;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.focus();
        textarea.select();
        textarea.setSelectionRange(0, textarea.value.length);
        copied = document.execCommand('copy');
        textarea.remove();
      }

      if (copied) copyButton.classList.add('is-copied');
      copyLabel.textContent = copied ? 'Copied RSS feed URL' : 'Copy failed';

      window.setTimeout(() => {
        copyButton.classList.remove('is-copied');
        copyLabel.textContent = 'Copy RSS feed URL';
      }, 1800);
    });
  </script>
</Layout>

<style>
  .podcast-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  :global(html[data-theme='light']) .eyebrow,
  :global(html[data-theme='light']) .live-recording-label,
  :global(html[data-theme='light']) .episode-row-meta span:first-child,
  :global(html[data-theme='light']) .episodes :global(.section-title) {
    color: var(--oc-accent-primary-deep);
  }

  .rail {
    width: 100%;
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 var(--oc-space-7);
    border-left: 1px solid var(--oc-border-subtle);
    border-right: 1px solid var(--oc-border-subtle);
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .podcast-hero {
    display: grid;
    grid-template-areas:
      'content cover'
      'listen cover';
    grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
    gap: 24px 56px;
    align-items: start;
    padding: 56px 0 48px;
  }

  .hero-content {
    grid-area: content;
    align-self: end;
    padding-top: 8px;
  }

  .eyebrow {
    margin-bottom: 10px;
    color: var(--oc-accent-primary);
    font-family: var(--oc-font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-size: 4.75rem;
    font-weight: 600;
    line-height: 1;
  }

  .intro {
    max-width: 600px;
    margin-top: 14px;
    color: var(--oc-text-secondary);
    font-size: 1.12rem;
  }

  .live-recording-cta {
    display: grid;
    width: min(100%, 520px);
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: var(--oc-space-3);
    align-items: center;
    margin-top: var(--oc-space-5);
    padding: var(--oc-space-3) var(--oc-space-4);
    border-color: var(--oc-border-accent);
    background: var(--oc-surface-accent-soft);
    color: var(--oc-text-primary);
  }

  .live-recording-cta:hover {
    border-color: var(--oc-accent-primary);
    background: color-mix(in srgb, var(--oc-surface-accent-soft) 72%, var(--oc-accent-primary));
    color: var(--oc-text-primary);
  }

  .live-recording-cta:focus-visible {
    outline-color: var(--oc-focus-ring);
    outline-offset: 3px;
  }

  .live-recording-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    color: var(--oc-text-primary);
  }

  .live-recording-icon svg {
    width: 19px;
    height: 19px;
    fill: currentColor;
  }

  .live-recording-copy {
    display: grid;
    min-width: 0;
    gap: 1px;
  }

  .live-recording-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--oc-accent-primary);
    font-family: var(--oc-font-mono);
    font-size: var(--oc-font-size-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .live-recording-dot {
    width: 6px;
    height: 6px;
    border-radius: var(--oc-radius-round);
    background: currentColor;
  }

  .live-recording-copy strong {
    overflow: hidden;
    font-size: var(--oc-font-size-md);
    font-weight: 650;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .live-recording-time {
    color: var(--oc-text-secondary);
    font-size: var(--oc-font-size-xs);
  }

  .live-recording-arrow {
    color: var(--oc-text-muted);
    transition:
      color var(--oc-duration-fast) var(--oc-ease-out),
      transform var(--oc-duration-fast) var(--oc-ease-out);
  }

  .live-recording-cta:hover .live-recording-arrow {
    color: var(--oc-accent-primary);
    transform: translate(2px, -2px);
  }

  .podcast-cover-frame {
    grid-area: cover;
    width: min(100%, 340px);
    align-self: center;
    justify-self: end;
    padding: 6px;
    border: 1px solid var(--oc-border-subtle);
    background: var(--oc-surface-card-strong);
    box-shadow: 7px 7px 0 color-mix(in srgb, var(--oc-accent-primary) 34%, transparent);
  }

  .podcast-cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
  }

  .episodes {
    padding: 48px 0 64px;
    border-top: 1px solid var(--oc-border-subtle);
  }

  .episode-list {
    list-style: none;
  }

  .episode-row {
    position: relative;
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    margin: 0 -24px;
    padding: 30px 24px;
    border-bottom: 1px solid var(--oc-border-subtle);
    transition: background var(--oc-duration-fast) var(--oc-ease-out);
  }

  .episode-row:first-child {
    border-top: 1px solid var(--oc-border-subtle);
  }

  .episode-row:hover {
    background: var(--oc-bg-surface);
  }

  .episode-row-meta {
    display: grid;
    gap: 10px;
    color: var(--oc-text-secondary);
    font-family: var(--oc-font-mono);
    font-size: 0.74rem;
  }

  .episode-row-meta span:first-child {
    color: var(--oc-accent-primary);
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .episode-row-meta time {
    line-height: 1.35;
  }

  .episode-row-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .episode-row-header h3 {
    margin-top: -4px;
    color: var(--oc-text-primary);
    font-family: var(--oc-font-display);
    font-size: 1.42rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .episode-row-header h3 a {
    color: inherit;
    text-decoration: none;
  }

  .episode-row-header h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .episode-row:hover .episode-row-header h3 a {
    color: var(--oc-accent-primary);
  }

  .episode-summary {
    max-width: 72ch;
    margin-top: 10px;
    color: var(--oc-text-secondary);
    font-size: 0.98rem;
    line-height: 1.55;
  }

  .episode-row-actions {
    position: relative;
    z-index: 1;
    display: flex;
    flex-shrink: 0;
    gap: 8px;
  }

  .episode-row-actions a {
    display: inline-flex;
    width: 28px;
    height: 28px;
    align-items: center;
    justify-content: center;
    color: var(--oc-text-secondary);
    text-decoration: none;
  }

  .episode-row-actions svg {
    width: 17px;
    height: 17px;
    fill: currentColor;
  }

  .episode-row-actions a:hover {
    color: var(--oc-accent-primary);
  }

  .episode-row-actions a:focus-visible,
  .episode-row-header h3 a:focus-visible {
    outline: 2px solid var(--oc-focus-ring);
    outline-offset: 3px;
  }

  .platform-panel {
    grid-area: listen;
  }

  .platforms {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    gap: 8px;
  }

  .platform-card {
    display: grid;
    min-width: 0;
    min-height: 64px;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border: 1px solid var(--oc-border-subtle);
    border-radius: 0;
    color: var(--oc-text-primary);
    text-decoration: none;
    transition:
      border-color var(--oc-duration-fast) var(--oc-ease-out),
      color var(--oc-duration-fast) var(--oc-ease-out);
  }

  .platform-card:hover {
    border-color: var(--oc-accent-primary);
  }

  .platform-card:focus-visible {
    outline: 2px solid var(--oc-focus-ring);
    outline-offset: 2px;
  }

  .platform-icon {
    display: inline-flex;
    width: 24px;
    height: 24px;
    align-items: center;
    justify-content: center;
    color: var(--oc-text-primary);
  }

  .platform-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .platform-content {
    display: grid;
    min-width: 0;
    gap: 1px;
  }

  .platform-name {
    overflow: hidden;
    font-size: 0.92rem;
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .platform-action {
    color: var(--oc-text-secondary);
    font-size: 0.74rem;
  }

  .platform-card:hover .platform-action {
    color: var(--oc-accent-primary);
  }

  .platform-card--coming-soon {
    cursor: default;
    color: var(--oc-text-secondary);
  }

  .platform-card--coming-soon .platform-icon,
  .platform-card--coming-soon .platform-content {
    opacity: 0.7;
  }

  .platform-card--rss {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    aspect-ratio: 1;
    padding: 0;
    background: transparent;
    color: var(--oc-text-secondary);
    cursor: pointer;
  }

  .platform-card--rss:hover {
    color: var(--oc-accent-primary);
  }

  .platform-card--rss .check-icon {
    display: none;
  }

  .platform-card--rss.is-copied .rss-icon {
    display: none;
  }

  .platform-card--rss.is-copied .check-icon {
    display: block;
    color: var(--oc-accent-primary);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 960px) {
    .episode-row {
      grid-template-columns: 110px minmax(0, 1fr);
      gap: 22px;
    }
  }

  @media (max-width: 720px) {
    .rail {
      padding: 0 20px;
      border-left: none;
      border-right: none;
    }

    .podcast-hero {
      grid-template-areas:
        'content'
        'cover'
        'listen';
      grid-template-columns: 1fr;
      gap: var(--oc-space-4);
      padding-top: var(--oc-space-6);
      padding-bottom: var(--oc-space-4);
    }

    .hero-content {
      padding-top: 0;
    }

    h1 {
      font-size: 3.25rem;
    }

    .podcast-cover-frame {
      width: min(100%, 200px);
      justify-self: start;
    }

    .episode-row {
      grid-template-columns: 1fr;
      gap: 10px;
      margin: 0 -20px;
      padding: 26px 20px;
    }

    .episodes {
      padding: var(--oc-space-4) 0 56px;
    }

    .episode-row-meta {
      display: flex;
      flex-wrap: wrap;
      column-gap: 10px;
    }

    .episode-row-meta time::before {
      content: '·';
      margin-right: 10px;
      color: var(--oc-border-subtle);
    }

    .platforms {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .platform-card {
      min-height: var(--oc-control-min-height);
      padding: var(--oc-space-2);
    }

    .platform-card--rss {
      aspect-ratio: auto;
      padding: 0;
    }

  }
</style>
